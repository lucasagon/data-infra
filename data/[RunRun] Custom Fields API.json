    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO runrun_staging.custom_fields_a (\n    id,\n    label,\n    updated_at\n)\nSELECT DISTINCT ON (id)\n    id,\n    label,\n    extracted_at AS updated_at\nFROM runrun_raw.custom_fields_a\nORDER BY id, extracted_at DESC\nON CONFLICT (id)\nDO UPDATE SET\n    label = EXCLUDED.label,\n    updated_at = EXCLUDED.updated_at;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1184,
        -432
      ],
      "id": "ab0c2d64-8c53-4309-8995-f7f4e6a8c453",
      "name": "Fields: staging -> analytics",
      "credentials": {
        "postgres": {
          "id": "lSK4RLQrmXu0xjBL",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO runrun_staging.task_custom_fields_a (record_id, task_id, created_at, field_id, field_name, field_value, value_id, value_color, value_label, updated_at)\nSELECT\nmd5(task_id || '-' || field_id) AS record_id,\ntask_id,\ncreated_at,\nfield_id,\nfield_name,\nfield_value,\nCASE\nWHEN jsonb_typeof(field_value) = 'object' THEN field_value ->> 'id'\nWHEN jsonb_typeof(field_value) = 'array' THEN field_value -> 0 ->> 'id'\nWHEN jsonb_typeof(field_value) = 'string' AND field_value::text LIKE '%id%' THEN substring(field_value::text FROM '''id'': ''([^'']+)''')\nELSE NULL\nEND AS value_id,\nCASE\nWHEN jsonb_typeof(field_value) = 'object' THEN field_value ->> 'color'\nWHEN jsonb_typeof(field_value) = 'array' THEN field_value -> 0 ->> 'color'\nWHEN jsonb_typeof(field_value) = 'string' AND field_value::text LIKE '%color%' THEN substring(field_value::text FROM '''color'': ([^,}\\]]+)')\nELSE NULL\nEND AS value_color,\nCASE\nWHEN jsonb_typeof(field_value) = 'object' THEN field_value ->> 'label'\nWHEN jsonb_typeof(field_value) = 'array' THEN field_value -> 0 ->> 'label'\nWHEN jsonb_typeof(field_value) = 'string' AND field_value::text LIKE '%label%' THEN substring(field_value::text FROM '''label'': ''([^'']+)''')\nWHEN jsonb_typeof(field_value) IN ('string', 'number', 'boolean') THEN trim(both '\"' from field_value::text)\nELSE NULL\nEND AS value_label,\nnow() AS updated_at\nFROM (\nSELECT DISTINCT ON (\nt.payload_json::jsonb ->> 'id',\ncf.key\n)\n(t.payload_json::jsonb ->> 'id')::text AS task_id,\n(t.payload_json::jsonb ->> 'created_at')::timestamptz AS created_at,\ncf.key AS field_id,\ncfa.label AS field_name,\ncf.value AS field_value\nFROM runrun_raw.tasks_a t\nCROSS JOIN LATERAL jsonb_each(\nt.payload_json::jsonb -> 'custom_fields'\n) cf(key, value)\nLEFT JOIN runrun_staging.custom_fields_a cfa\nON cfa.id = cf.key\nWHERE\ncf.value <> 'null'::jsonb\nAND t.extracted_at > '2026-05-15 19:23:36.288+00'\nORDER BY\nt.payload_json::jsonb ->> 'id',\ncf.key,\n(t.payload_json::jsonb ->> 'created_at')::timestamptz DESC\n) x\nON CONFLICT (record_id, field_id)\nDO UPDATE SET\ntask_id = EXCLUDED.task_id,\ncreated_at = EXCLUDED.created_at,\nfield_name = EXCLUDED.field_name,\nfield_value = EXCLUDED.field_value,\nvalue_id = EXCLUDED.value_id,\nvalue_color = EXCLUDED.value_color,\nvalue_label = EXCLUDED.value_label,\nupdated_at = now();",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,

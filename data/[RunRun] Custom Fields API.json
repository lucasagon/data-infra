      "parameters": {
        "operation": "executeQuery",
        "query": "WITH latest_tasks AS (\n      SELECT DISTINCT ON (board_id)\n          board_id,\n          task_id,\n          title,\n          created_at,\n          extracted_at\n      FROM runrun_staging.tasks_a\n      WHERE board_id IS NOT NULL\n      ORDER BY\n          board_id,\n          extracted_at DESC NULLS LAST,\n          created_at DESC NULLS LAST,\n          task_id DESC\n  )\n  SELECT\n      b.record_id AS board_id,\n      lt.task_id\n  FROM runrun_raw.boards_a b\n  LEFT JOIN latest_tasks lt\n      ON lt.board_id::text = b.record_id\n  ORDER BY b.record_id;",
